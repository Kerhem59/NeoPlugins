# Discord bot token (zorunlu - main.json yerine buraya yazın)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Plugin ile aynı API anahtarı
API_KEY=YOUR_API_KEY_HERE

# Bot HTTP API portu (plugin BotUrl bu portu kullanmalı)
API_PORT=4023

# Unturned plugin dinleyici portu (RCON / Discord -> oyun)
PLUGIN_LISTENER_PORT=4024

MYSQL_HOST=127.0.0.1
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=Neo_Towny
